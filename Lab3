#!/bin/bash
dl1=${#1}
dl2=${#2}

if [[ $dl1 -gt $dl2 ]]; then
    echo "Dłuższy napis to: $1"
elif [[ $dl2 -gt $dl1 ]]; then
    echo "Dłuższy napis to: $2"
else
    echo "Napisy mają taką samą długość."
fi

if [[ "$1" < "$2" ]]; then
    echo "Wcześniej leksykograficznie: $1"
elif [[ "$1" > "$2" ]]; then
    echo "Wcześniej leksykograficznie: $2"
else
    echo "Napisy są identyczne."
fi

