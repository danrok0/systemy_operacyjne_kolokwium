#!/bin/bash
function odwroc_napis {
    napis=$1
    odwrocony=""
    for (( i=${#napis}-1; i>=0; i-- )); do
        odwrocony="$odwrocony${napis:$i:1}"
    done
    echo "$odwrocony"
}
odwroc_napis "$1"

