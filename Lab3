#!/bin/bash
if [[ -e "$1" ]]; then
    echo "Podany argument jest poprawną ścieżką."
    
    if [[ -f "$1" ]]; then
        echo "Typ: Zwykły plik"
    elif [[ -d "$1" ]]; then
        echo "Typ: Katalog"
    fi

    echo -n "Prawa dostępu: "
    [[ -r "$1" ]] && echo -n "odczyt "
    [[ -w "$1" ]] && echo -n "zapis "
    [[ -x "$1" ]] && echo -n "wykonanie"
    echo ""
else
    echo "Ścieżka nie istnieje."
fi

